#!/usr/bin/env bash
set -euo pipefail

WT_ROOT="${COWTREE_WT_ROOT:-$HOME/dev/wt}"

usage() {
  cat <<USAGE
cowtree add <base-checkout> <topic> [--from <ref>] [--branch <name>] [--dest <path>]
cowtree rm  <worktree-path> [--force]
cowtree ls  [<base-checkout>]
USAGE
  exit 1
}

die() { echo "cowtree: $*" >&2; exit 1; }

same_volume() { [ "$(stat -f %d "$1")" = "$(stat -f %d "$2")" ]; }

is_apfs() { [ "$(df -T apfs "$1" 2>/dev/null | wc -l)" -gt 1 ]; }

clone_tree() {
  local src=$1 dst=$2 mode=$3
  local entry
  for entry in "$src"/.[!.]* "$src"/..?* "$src"/*; do
    [ -e "$entry" ] || [ -L "$entry" ] || continue
    [ "$(basename "$entry")" = ".git" ] && continue
    if [ "$mode" = cow ]; then
      cp -c -R -P "$entry" "$dst/"
    else
      cp -R -P "$entry" "$dst/"
    fi
  done
}

cmd_add() {
  [ $# -ge 2 ] || usage
  local base topic ref="" branch="" dest=""
  base=$(cd "$1" && pwd -P); topic=$2; shift 2
  while [ $# -gt 0 ]; do
    case $1 in
      --from) ref=$2; shift 2 ;;
      --branch) branch=$2; shift 2 ;;
      --dest) dest=$2; shift 2 ;;
      *) usage ;;
    esac
  done
  git -C "$base" rev-parse --is-inside-work-tree >/dev/null 2>&1 || die "$base is not a git checkout"
  [ -z "$(git -C "$base" status --porcelain --untracked-files=no)" ] || die "$base has uncommitted changes; cowtree needs a clean base"
  local repo; repo=$(basename "$base")
  [ -n "$dest" ] || dest="$WT_ROOT/$repo-$topic"
  [ -n "$branch" ] || branch="$topic"
  [ -n "$ref" ] || ref=$(git -C "$base" rev-parse --abbrev-ref HEAD)
  [ ! -e "$dest" ] || die "$dest exists"
  mkdir -p "$(dirname "$dest")"

  local mode=cow
  if ! is_apfs "$base" || ! same_volume "$base" "$(dirname "$dest")"; then
    mode=copy; echo "cowtree: not APFS or different volume; falling back to full copy" >&2
  fi

  if git -C "$base" show-ref --verify --quiet "refs/heads/$branch"; then
    git -C "$base" worktree add --no-checkout "$dest" "$branch"
  else
    git -C "$base" worktree add --no-checkout -b "$branch" "$dest" "$ref"
  fi
  clone_tree "$base" "$dest" "$mode"
  # populate the index without touching the clones, then rewrite only files that differ from the ref
  git -C "$dest" read-tree HEAD
  git -C "$dest" update-index -q --refresh || true
  git -C "$dest" diff --name-only -z | xargs -0 -r git -C "$dest" checkout -q --
  git -C "$dest" ls-files --others --exclude-standard -z | xargs -0 -r rm -f
  git -C "$dest" update-index -q --refresh || true
  echo "$dest"
}

cmd_rm() {
  [ $# -ge 1 ] || usage
  local dest force=""
  dest=$(cd "$1" && pwd -P); shift
  [ "${1:-}" = "--force" ] && force="--force"
  local gitdir branch common
  gitdir=$(git -C "$dest" rev-parse --git-dir)
  common=$(git -C "$dest" rev-parse --path-format=absolute --git-common-dir)
  branch=$(git -C "$dest" rev-parse --abbrev-ref HEAD)
  git -C "$dest" worktree remove $force "$dest"
  local main; main=$(dirname "$common")
  if [ "$branch" != HEAD ] && git -C "$main" branch --merged | grep -qx "[ *+]*$branch"; then
    git -C "$main" branch -d "$branch" >/dev/null && echo "deleted merged branch $branch"
  else
    echo "kept branch $branch (not merged)"
  fi
}

human() { awk -v b="$1" 'BEGIN{s="B KB MB GB TB";split(s,u," ");i=1;while(b>=1024&&i<5){b/=1024;i++}printf "%.1f%s",b,u[i]}'; }

phys_bytes() {
  # physical blocks actually allocated; APFS clones that still share blocks with the base are not counted
  local root=$1 base=$2
  python3 - "$root" "$base" <<'PY'
import os, sys, subprocess
root, base = sys.argv[1], sys.argv[2]
# count a file as owned by the worktree if its content differs from the base path or base has no such path
total = 0
for d, dirs, files in os.walk(root):
    if '.git' in dirs: dirs.remove('.git')
    rel = os.path.relpath(d, root)
    for f in files:
        p = os.path.join(d, f)
        try: st = os.lstat(p)
        except OSError: continue
        if not os.path.isfile(p) or os.path.islink(p): continue
        bp = os.path.join(base, rel, f) if rel != '.' else os.path.join(base, f)
        try:
            bst = os.lstat(bp)
            if bst.st_size == st.st_size and bst.st_mtime_ns == st.st_mtime_ns:
                continue
        except OSError:
            pass
        total += st.st_blocks * 512
print(total)
PY
}

cmd_ls() {
  local base=${1:-.}
  git -C "$base" worktree list --porcelain | awk '/^worktree /{print $2}' | while read -r wt; do
    local main; main=$(dirname "$(git -C "$wt" rev-parse --path-format=absolute --git-common-dir)")
    [ "$wt" = "$main" ] && { echo "$wt  (base)"; continue; }
    local logical physical
    logical=$(du -sk "$wt" 2>/dev/null | cut -f1); logical=$((logical*1024))
    physical=$(phys_bytes "$wt" "$main")
    printf "%s  logical %s  owned %s\n" "$wt" "$(human "$logical")" "$(human "$physical")"
  done
}

case ${1:-} in
  add) shift; cmd_add "$@" ;;
  rm) shift; cmd_rm "$@" ;;
  ls) shift; cmd_ls "$@" ;;
  *) usage ;;
esac
